# Copy this file to `.env` and fill in the values you want to enable.
# Everything here is optional — the site works without it.
# Vite only exposes variables prefixed with VITE_ to the browser,
# so never put a secret/private API key in this file.

# --- Contact form (optional, free) -----------------------------------------
# Get a free access key at https://web3forms.com (250 submissions/month, no card).
# Without this, the contact form falls back to opening the visitor's mail client.
VITE_WEB3FORMS_KEY=

# --- Google Analytics (optional, free) -------------------------------------
# GA4 Measurement ID, looks like G-XXXXXXXXXX.
# Without this, analytics is simply disabled.
VITE_GA_MEASUREMENT_ID=
